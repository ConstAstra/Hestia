# Clé API Anthropic (https://console.anthropic.com) — nécessaire pour l'outil de création.
ANTHROPIC_API_KEY=

# Nombre de recherches de dupes autorisées par adresse IP et par heure (défaut : 5).
DUPES_HOURLY_LIMIT=5

# Clé API Pexels (gratuite : https://www.pexels.com/api/) — photos réelles du fil d'inspiration.
# Sans clé, l'application tourne en mode démonstration avec le catalogue interne.
PEXELS_API_KEY=

# Secret pour déclencher l'actualisation des tendances : POST /api/trends/refresh
# avec l'en-tête « Authorization: Bearer <secret> ». Sur Vercel, CRON_SECRET est utilisé
# par la tâche planifiée hebdomadaire (vercel.json).
TRENDS_REFRESH_SECRET=
# Emplacement du fichier de veille (par défaut : .data/trends.json).
TRENDS_STORE_PATH=

# Liens « Acheter via Hestia » (/acheter) : secret de signature, pour que la passerelle
# ne redirige que vers les produits proposés par Hestia. Générez une longue chaîne aléatoire
# (ex. : openssl rand -base64 32). Sans secret, seules les enseignes connues sont acceptées.
AFFILIATE_LINK_SECRET=
# Programmes d'affiliation par domaine (JSON). Paramètres ajoutés à l'URL, ou gabarit de
# lien profond où {url} est remplacé par l'URL produit encodée. Exemple :
# AFFILIATE_PROGRAMS={"amazon.fr":{"params":{"tag":"hestia-21"}},"maisonsdumonde.com":{"template":"https://www.awin1.com/cread.php?awinmid=XXXX&awinaffid=YYYY&ued={url}"}}
AFFILIATE_PROGRAMS=
